{
  "realm": "kx",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "bruteForceProtected": false,

  "accessTokenLifespan": 1800,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,

  "oauth2DeviceCodeLifespan": 600,
  "oauth2DevicePollingInterval": 1,

  "roles": {
    "realm": [
      {
        "name": "trader",
        "description": "May read data.trades and data.instruments in the demo host's policy"
      },
      {
        "name": "viewer",
        "description": "May read data.instruments only"
      },
      {
        "name": "policy-admin",
        "description": "May atomically administer the demo host's kx.rbac policy"
      }
    ]
  },

  "users": [
    {
      "username": "alice",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "Trader",
      "email": "alice@example.invalid",
      "credentials": [
        { "type": "password", "value": "alice-demo-pw", "temporary": false }
      ],
      "realmRoles": ["trader", "viewer", "policy-admin"]
    },
    {
      "username": "bob",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Bob",
      "lastName": "Viewer",
      "email": "bob@example.invalid",
      "credentials": [
        { "type": "password", "value": "bob-demo-pw", "temporary": false }
      ],
      "realmRoles": ["viewer"]
    }
  ],

  "clients": [
    {
      "clientId": "kx-auth-cli",
      "name": "kx auth CLI (public, device code)",
      "description": "The terminal persona. Device-code because that is the only interactive flow the CLI implements; direct access grants are enabled so the demo's checks can mint a token with plain curl instead of driving a browser.",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": true,
      "attributes": {
        "oauth2.device.authorization.grant.enabled": "true"
      },
      "protocolMappers": [
        {
          "name": "kdbx-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "kdbx",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "envoy-gateway",
      "name": "Envoy gateway (confidential, auth code)",
      "description": "The browser persona. Envoy's oauth2 filter runs auth-code + PKCE on the user's behalf, which is the interactive flow q will never provide.",
      "enabled": true,
      "publicClient": false,
      "secret": "envoy-gateway-demo-secret",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": true,
      "redirectUris": [
        "http://localhost:10002/*"
      ],
      "webOrigins": ["http://localhost:10002"],
      "protocolMappers": [
        {
          "name": "kdbx-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "kdbx",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ]
}
